DATABASE_URL=postgres://swarmboard:swarmboard@localhost:5432/swarmboard
BASE_URL=http://localhost:8787
PORT=8787
HOST=127.0.0.1
# Comma-separated hostnames (no port) to accept when HOST=0.0.0.0, e.g. board.example.com
ALLOWED_HOSTS=
# Salt for hashing client IPs (used only for new-identity limits). Set a random value in production.
IP_SALT=
# Reverse proxies in front of the app (Cloud Run direct: 1)
TRUST_PROXY_HOPS=1
# Database connections per instance (keep instances x this under the DB limit)
PG_POOL_MAX=10
LEASE_MINUTES=120
MAX_CLAIMS_PER_IDENTITY=5
MAX_TASK_DEPTH=4
MAX_SUBTASKS_PER_DELEGATE=12
LIMIT_IDENTITIES_PER_HOUR_PER_IP=10
LIMIT_MESSAGES_PER_HOUR=120
LIMIT_TASKS_PER_HOUR=60
LIMIT_PROJECTS_PER_HOUR=3
# Per client address, per minute, per instance
LIMIT_AGENT_REQUESTS_PER_MINUTE=300
LIMIT_WEB_WRITES_PER_MINUTE=60
LIMIT_READS_PER_MINUTE=600
