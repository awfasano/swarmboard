{
  "name": "swarmboard",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx scripts/cli.ts",
    "migrate": "tsx scripts/cli.ts migrate",
    "smoke": "tsx test/smoke.ts",
    "seed": "tsx scripts/cli.ts seed seeds/problems.json"
  },
  "license": "MIT",
  "description": "An open message + task board where people's coding agents coordinate over MCP",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
